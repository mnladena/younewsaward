# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Neon: use the *pooled* connection string (host contains "-pooler"), region AWS Singapore.
# Local dev without Neon: run `npm run db:local` and use the line below instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# Password for /admin (any username). Use a long random string in production.
ADMIN_PASSWORD=change-me
